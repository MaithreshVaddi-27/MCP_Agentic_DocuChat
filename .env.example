# MCP_Agentic_DocuChat — configuration
#
# Copy to .env and fill in only what you need. Every value below is the
# built-in default, so an untouched .env runs fully offline.
#
# Documents are NOT configured here — you upload PDFs in the browser UI.

# ============================================================ chat providers
# Pick one in the UI. Ollama / llama.cpp / MLX run fully offline.
# The UI's Local-model dropdown overrides the *_MODEL values at runtime.

# --- Ollama (start with `ollama serve`) -------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_KEEP_ALIVE=10m          # how long the model stays warm after a question
OLLAMA_NUM_CTX=4096            # context window
OLLAMA_STATUS_CACHE_SECONDS=15 # trust a health probe this long before re-checking

# --- llama.cpp (start with `llama-server -hf <model> --port 8080`) ---
# LLAMACPP_MODEL only needs to match what the server reports; the app
# adopts the served model automatically if it doesn't.
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_MODEL=Qwen3-4B-GGUF:Q4_0
LLAMACPP_NUM_CTX=4096
LLAMACPP_STATUS_CACHE_SECONDS=15
# Only needed if you put an authenticating reverse proxy in front of
# llama-server. The server itself ignores it.
LLAMACPP_API_KEY=not-needed

# --- MLX, Apple Silicon (pipx install mlx-lm) -------------------------
#   mlx_lm.server --model mlx-community/gemma-3-4b-it-4bit --port 8081
MLX_BASE_URL=http://localhost:8081/v1
MLX_MODEL=mlx-community/gemma-3-4b-it-4bit
MLX_NUM_CTX=4096
MLX_STATUS_CACHE_SECONDS=15
MLX_API_KEY=not-needed         # only behind an authenticating proxy

# --- Gemini (optional, needs an API key) ------------------------------
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ========================================================= model discovery
# Where `python -m agentic_docuchat.llm.models` looks for local models that
# are on disk but not currently being served. Set these only if you keep
# weights somewhere other than the defaults.
# HF_HOME=~/.cache/huggingface        # HF cache root
# OLLAMA_HOME=~/.ollama               # Ollama data dir
# LLAMACPP_MODEL_DIRS=/path/a:/path/b # extra dirs to scan for *.gguf

# ============================================================== embeddings
# local  = HuggingFace sentence-transformer on this machine, no API calls
#          (one-time ~1.3 GB download for the default model)
# online = Google embedding API, needs GEMINI_API_KEY, no local download
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_MODEL_ONLINE=models/text-embedding-004
# Only if HuggingFace rate-limits your embedding download.
HF_TOKEN=

# ============================================== optional web tools (MCP)
# Composio toolkits give the agent web search. Leave blank for pure-document
# mode, which keeps local providers streaming.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
# Comma-separated. Connect these in your Composio account.
COMPOSIO_TOOLKITS=TAVILY

# ============================================================== retrieval
CHUNK_SIZE=700
CHUNK_OVERLAP=100              # rebuild the index after changing chunking
RETRIEVAL_K=4                  # passages that reach the model
RETRIEVAL_FETCH_K=12           # candidate pool for MMR search
# 1 = answer once, 2 = one grounding-repair retry when the draft has no
# page citation. Applies to every provider.
ANSWER_LOOP_MAX_ATTEMPTS=2

# ================================================================= uploads
# Largest PDF you'll accept, in megabytes. Bigger files are refused politely.
MAX_PDF_MB=50

# ================================================= memory, cache, storage
MEMORY_DATABASE=./agentic_rag_memory.sqlite3
CHROMA_DIR=./chroma_langchain_db
CHROMA_COLLECTION=agentic_rag_research_collection
# Answer cache: bounded so it can't grow forever. Entries older than the TTL
# are treated as misses and the table is pruned to CACHE_MAX_ENTRIES.
CACHE_TTL_SECONDS=604800
CACHE_MAX_ENTRIES=2000

# Seconds between two questions from the same User ID — stops double-clicks,
# not attackers. RATE_LIMIT_MAX_USERS caps how many IDs are tracked.
RATE_LIMIT_SECONDS=1.5
RATE_LIMIT_MAX_USERS=1024

# ================================================================ access
# Sharing and login are independent:
#  - GRADIO_SHARE=true makes a temporary public URL, and refuses to start
#    unless both credentials below are set.
#  - Setting both credentials requires login everywhere, shared or local.
# Keep sharing off for private documents.
GRADIO_SHARE=false
GRADIO_USERNAME=choose_a_username
GRADIO_PASSWORD=choose_a_strong_password

# ================================================================== debug
# DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO