# Secrets — never commit real keys.
# The template stays tracked; every other .env.* variant is treated as secret.
.env
.env.*
!/.env.example
*.env

# Vector store + memory (runtime generated, per-machine)
chroma_langchain_db/
chroma_db/
*.sqlite3
*.sqlite3-*

# Uploads (user PDFs are private local data)
data/uploads/
data/*.pdf

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.env_venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Eval / experiment outputs
eval/results/
*.eval.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Model weights — this project downloads LLMs, keep them out of git
*.gguf
*.safetensors
*.bin
*.pt
*.pth
models/
local_models/

# Gradio runtime (flagged examples, local certs) + version pin
flagged/
.gradio/
.python-version

# Logs & temp
*.log
*.tmp
tmp/
temp/

# Merge / editor leftovers
*.orig
*.rej
*.bak
*~

# Notebooks
.ipynb_checkpoints/

